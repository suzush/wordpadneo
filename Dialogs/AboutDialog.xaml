<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="wordpadneo.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:wordpadneo.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="AboutDialog"
    mc:Ignorable="d"
    Title="バージョン情報"
    PrimaryButtonText="閉じる"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="10" Width="320">
        <FontIcon Glyph="&#xE946;" 
                  FontSize="48" 
                  Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                  HorizontalAlignment="Center" 
                  Margin="0,10,0,10"/>

        <TextBlock Text="WordPad Neo" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"/>

        <TextBlock x:Name="VersionText" 
                   Text="" 
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"/>

        <MenuFlyoutSeparator Margin="0,5,0,5"/>

        <TextBlock x:Uid="AboutDialog_CopyrightText"
                   Text="© 2026 Suzush Labs" 
                   FontSize="12" 
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</ContentDialog>
